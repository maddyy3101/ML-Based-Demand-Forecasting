# Copy this file to .env.local and fill your real values.
# Never commit .env.local or real keys.

# LLM provider keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Startup profile: auto | local | test | docker
BACKEND_PROFILE=auto

# Local PostgreSQL settings (used when BACKEND_PROFILE resolves to local)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=powergrid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
